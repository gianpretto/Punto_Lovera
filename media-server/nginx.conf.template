load_module /usr/lib/nginx/modules/ngx_rtmp_module.so;

# nginx-rtmp comparte el estado de los streams por worker: con uno solo no
# hace falta rtmp_auto_push (alcanza para varios remates a la vez).
worker_processes 1;
pid /run/nginx/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 1024;
}

rtmp {
    server {
        listen 1935;
        chunk_size 4096;

        application live {
            live on;
            record off;

            # OBS publica a rtmp://<host>:<puerto>/live con la clave
            # "camera_<id>" que muestra el panel del martillero. Antes de
            # aceptar, nginx pregunta al backend (2xx = válida, otro = corta).
            # Pasa por /auth/publish (abajo) y no directo al backend: nginx-rtmp
            # resuelve el DNS una sola vez al arrancar, y en Railway la IP
            # interna del backend cambia en cada deploy.
            on_publish http://127.0.0.1:8080/auth/publish;

            # Nadie mira por RTMP: el video sale solo como HLS por el backend
            deny play all;

            hls on;
            hls_path /tmp/hls;
            hls_nested on;
            hls_fragment 2s;
            hls_playlist_length 12s;
            hls_cleanup on;
        }
    }
}

http {
    access_log off;
    sendfile off;
    default_type application/octet-stream;

    # DNS interno (de /etc/resolv.conf): el backend se resuelve en cada pedido
    resolver ${DNS_RESOLVER} valid=10s;

    server {
        # Red privada de Railway (IPv6) y local (IPv4)
        listen 8080;
        listen [::]:8080;

        location /hls {
            types {
                application/vnd.apple.mpegurl m3u8;
                video/mp2t ts;
            }
            alias /tmp/hls;
            add_header Cache-Control no-cache;
        }

        # Validación de la clave: la llama el módulo rtmp de este mismo nginx
        # y se reenvía al backend (con proxy_pass por variable, así el nombre
        # se resuelve en cada transmisión y no queda una IP vieja).
        location = /auth/publish {
            allow 127.0.0.1;
            deny all;
            set $backend "${BACKEND_INTERNAL_URL}";
            proxy_pass $backend/api/live/rtmp/publish?secret=${RTMP_AUTH_SECRET};
            proxy_connect_timeout 5s;
            proxy_read_timeout 10s;
        }

        # El backend corta una transmisión al anular la clave
        location /control {
            rtmp_control all;
        }

        location = /health {
            return 200 "ok\n";
        }
    }
}
