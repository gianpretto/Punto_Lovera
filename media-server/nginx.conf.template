load_module /usr/lib/nginx/modules/ngx_rtmp_module.so;

# nginx-rtmp comparte el estado de los streams por worker: con uno solo no
# hace falta rtmp_auto_push (alcanza para varios remates a la vez).
worker_processes 1;
pid /run/nginx/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 1024;
}

rtmp {
    server {
        listen 1935;
        chunk_size 4096;

        application live {
            live on;
            record off;

            # OBS publica a rtmp://<host>:<puerto>/live con la clave
            # "camera_<id>" que muestra el panel del martillero. Antes de
            # aceptar, nginx le pregunta al backend: 2xx = válida, otro = corta.
            on_publish ${BACKEND_INTERNAL_URL}/api/live/rtmp/publish?secret=${RTMP_AUTH_SECRET};

            # Nadie mira por RTMP: el video sale solo como HLS por el backend
            deny play all;

            hls on;
            hls_path /tmp/hls;
            hls_nested on;
            hls_fragment 2s;
            hls_playlist_length 12s;
            hls_cleanup on;
        }
    }
}

http {
    access_log off;
    sendfile off;
    default_type application/octet-stream;

    server {
        # Red privada de Railway (IPv6) y local (IPv4)
        listen 8080;
        listen [::]:8080;

        location /hls {
            types {
                application/vnd.apple.mpegurl m3u8;
                video/mp2t ts;
            }
            alias /tmp/hls;
            add_header Cache-Control no-cache;
        }

        # El backend corta una transmisión al anular la clave
        location /control {
            rtmp_control all;
        }

        location = /health {
            return 200 "ok\n";
        }
    }
}
