# Copiá este archivo a .env y completá los valores reales (.env NO se sube a git)

# Base de datos
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/puntolovera"

# Servidor
PORT=4000
NODE_ENV=development

# URL del frontend (para CORS y links en mails)
# Lista separada por comas: la primera se usa en los links de los mails
FRONTEND_URL="http://localhost:5173"

# Carpeta de archivos subidos (en Railway: el mount path del Volume, ej /data/uploads)
# UPLOAD_DIR=""

# Opcional (Neon): conexión directa, sin "-pooler", para correr migraciones
# MIGRATIONS_DATABASE_URL=""

# JWT
JWT_SECRET="cambiar-por-un-secreto-largo-y-random"
JWT_EXPIRES_IN="7d"

# Mail (verificación de cuenta / recuperar contraseña)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Punto Lovera <no-responder@puntolovera.com>"

# Datos de transferencia que se muestran en /creditos (sin pasarela de pago)
TRANSFER_ALIAS="puntolovera.mp"
TRANSFER_CBU="0000000000000000000000"
TRANSFER_HOLDER="Punto Lovera SRL"
TRANSFER_ACCOUNT="Cuenta corriente en pesos - Banco Ejemplo"

# Video en vivo con OBS (VIDEO_MODE=obs, por defecto): ver media-server/
# MEDIA_SERVER_URL: URL privada del media-server (ej http://media-server.railway.internal:8080)
# RTMP_PUBLIC_URL: lo que va en OBS como "Servidor" (TCP Proxy de Railway al 1935)
# RTMP_AUTH_SECRET: el mismo valor en el backend y en media-server
VIDEO_MODE="obs"
MEDIA_SERVER_URL="http://localhost:8080"
RTMP_PUBLIC_URL="rtmp://localhost:1935/live"
RTMP_AUTH_SECRET=""
# La subasta se abre sola al empezar a transmitir si faltan como mucho estas horas
AUTO_OPEN_WINDOW_HOURS=2

# Proxies delante del backend (para la IP real en los límites de intentos).
# Railway: 1 (su edge). Sin proxy (local directo): 0.
TRUST_PROXY="1"

# Modo anterior (VIDEO_MODE=rtsp): repo rtsp-manager de Francis
# controlUrl: API interna que prende/apaga cámaras — nunca exponer al público
# mediaUrl: nginx-rtmp que sirve HLS/DASH — este backend lo proxea con auth
RTSP_CONTROL_URL="http://localhost:5000"
RTSP_MEDIA_URL="http://localhost:8080"
